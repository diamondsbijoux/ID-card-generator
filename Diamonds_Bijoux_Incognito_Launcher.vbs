Option Explicit

Dim shell, fso, chrome, appUrl, iconPath, desktopPath, shortcutPath
Dim scriptPath, shortcut, stream, iconData

Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

appUrl = "https://script.google.com/macros/s/AKfycbyVE1sNbMgA5CueYsBfl8tlcZwYXj9i-GJj90ZdFPWARW7mg7lRhQqgX5Eem7AQz19R/exec"
scriptPath = WScript.ScriptFullName

' Save the embedded Diamonds Bijoux icon to the user's local app-data folder.
iconPath = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\DiamondsBijoux\Diamonds_Bijoux_App_Icon.ico"
If Not fso.FolderExists(fso.GetParentFolderName(iconPath)) Then
    fso.CreateFolder fso.GetParentFolderName(iconPath)
End If

iconData = ""

' Decode embedded Base64 icon and write the ICO file.
Dim xml, node
Set xml = CreateObject("Msxml2.DOMDocument.6.0")
Set node = xml.createElement("base64")
node.DataType = "bin.base64"
node.Text = iconData

Set stream = CreateObject("ADODB.Stream")
stream.Type = 1
stream.Open
stream.Write node.nodeTypedValue
stream.SaveToFile iconPath, 2
stream.Close

' Create a desktop shortcut with the embedded Diamonds Bijoux icon.
desktopPath = shell.SpecialFolders("Desktop")
shortcutPath = desktopPath & "\Diamonds Bijoux ID Card Generator.lnk"
Set shortcut = shell.CreateShortcut(shortcutPath)
shortcut.TargetPath = shell.ExpandEnvironmentStrings("%SystemRoot%") & "\System32\wscript.exe"
shortcut.Arguments = """" & scriptPath & """"
shortcut.WorkingDirectory = fso.GetParentFolderName(scriptPath)
shortcut.IconLocation = iconPath & ",0"
shortcut.Description = "Open Diamonds Bijoux ID Card Generator in Chrome Incognito"
shortcut.Save

' Find Chrome and launch the web app in Incognito mode.
chrome = shell.ExpandEnvironmentStrings("%ProgramFiles%") & "\Google\Chrome\Application\chrome.exe"
If Not fso.FileExists(chrome) Then
    chrome = shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%") & "\Google\Chrome\Application\chrome.exe"
End If
If Not fso.FileExists(chrome) Then
    chrome = shell.ExpandEnvironmentStrings("%LocalAppData%") & "\Google\Chrome\Application\chrome.exe"
End If

If fso.FileExists(chrome) Then
    shell.Run """" & chrome & """ --new-window --incognito --start-maximized """ & appUrl & """", 0, False
Else
    On Error Resume Next
    shell.Run "chrome.exe --new-window --incognito --start-maximized """ & appUrl & """", 0, False
    If Err.Number <> 0 Then
        MsgBox "Google Chrome was not found. Please install Chrome and try again.", vbCritical, "Diamonds Bijoux"
    End If
    On Error GoTo 0
End If

Set shortcut = Nothing
Set stream = Nothing
Set fso = Nothing
Set shell = Nothing
